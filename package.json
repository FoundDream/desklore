{
  "name": "desklore",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source computer history for macOS, built local-first",
  "homepage": "https://github.com/FoundDream/desklore#readme",
  "bugs": {
    "url": "https://github.com/FoundDream/desklore/issues"
  },
  "license": "Apache-2.0",
  "author": "Ziwen Song",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FoundDream/desklore.git"
  },
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "native:build": "./scripts/build-agent.sh",
    "dev": "pnpm native:build && electron-vite-plus dev -- -ApplePersistenceIgnoreState YES",
    "dev:ui": "electron-vite-plus dev -- -ApplePersistenceIgnoreState YES",
    "site:dev": "vp -C website dev",
    "site:build": "vp -C website build",
    "site:preview": "vp -C website preview",
    "build": "pnpm native:build && electron-vite-plus build",
    "check": "vp check",
    "test": "vp test run && node --test scripts/*.test.mjs",
    "eval:history": "node scripts/eval-history-data.mjs",
    "eval:timeline": "node scripts/eval-timeline.mjs",
    "eval:visual": "node scripts/eval-visual-policy.mjs",
    "eval:visual-value": "node scripts/eval-visual-value.mjs",
    "doctor": "electron-vite-plus doctor",
    "preview": "electron-vite-plus preview",
    "package:mac": "pnpm build && electron-builder --mac"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite-plus": "0.1.0-alpha.2",
    "jiti": "2.7.0",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plus": "0.2.9",
    "vitest": "4.1.10"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "build": {
    "appId": "com.desklore.desktop",
    "productName": "DeskLore",
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/DeskLore Collector.app",
        "to": "native/DeskLore Collector.app"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "minimumSystemVersion": "14.0",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "artifactName": "DeskLore-${version}-${arch}.${ext}"
    }
  }
}
